# Example environment configuration for estimate_backend

# DATABASE_URL:
# - Default (if not set): sqlite:///./estimates.db
# - SQLite file:
#     DATABASE_URL=sqlite:///./estimates.db
# - SQLite in-memory (not recommended for multi-connection use):
#     DATABASE_URL=sqlite://
# - Postgres example:
#     DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///./estimates.db

# CORS_ORIGINS:
# Comma-separated list of allowed origins for CORS. Example:
# CORS_ORIGINS=http://localhost:3000,https://myapp.example.com
# If not used, the app may fallback to allow all (*) depending on configuration.
CORS_ORIGINS=http://localhost:3000
